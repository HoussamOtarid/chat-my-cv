# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# NextAuth Configuration
# ============================================
# Generate a secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# ============================================
# Admin Credentials
# ============================================
# Initial admin account for setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# ============================================
# Encryption Configuration
# ============================================
# For encrypting sensitive data (API keys) in database
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ============================================
# Rate Limiting (Upstash Redis)
# ============================================
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Optional: Override default rate limits
RATE_LIMIT_MAX=30                    # Max requests per window (default: 30)
RATE_LIMIT_WINDOW_SECONDS=600        # Window duration in seconds (default: 600 = 10 minutes)

# ============================================
# Application Configuration
# ============================================
# Maximum file size for resume uploads (in bytes)
MAX_FILE_SIZE=10485760

# IP hashing salt for privacy-preserving analytics
# Generate: openssl rand -hex 16
IP_HASH_SALT=your-ip-hash-salt-here

# ============================================
# SEO & Site Configuration
# ============================================
# Your application URL (used for sitemap and Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Site verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=

# ============================================
# Development Configuration
# ============================================
NODE_ENV=development

# Bundle analyzer for checking bundle sizes
# BUNDLE_ANALYZER_ENABLED=true

# ============================================
# Error Monitoring (Sentry)
# ============================================
# Get your DSN from: https://sentry.io/settings/projects/{project}/keys/
# Leave empty to disable Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Optional: For source map uploads (improves error stack traces)
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token
