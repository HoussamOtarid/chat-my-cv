# ============================================
# Production Environment Configuration
# ============================================
# Copy this file to .env.production.local and fill in your production values
# These values will be used when running `npm run build` and in production deployment

# ============================================
# Supabase Configuration (REQUIRED)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# ============================================
# NextAuth Configuration (REQUIRED)
# ============================================
# Your production domain (no trailing slash)
NEXTAUTH_URL=https://chat-my-cv.vercel.app
# Generate a strong secret for production: openssl rand -base64 32
NEXTAUTH_SECRET=your-production-secret-minimum-32-chars

# ============================================
# Admin Credentials (REQUIRED)
# ============================================
# Production admin credentials (use strong password)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-very-secure-production-password

# ============================================
# Encryption Configuration (REQUIRED)
# ============================================
# Production encryption key for sensitive data
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-32-character-production-encryption-key

# ============================================
# Rate Limiting - Upstash Redis (REQUIRED)
# ============================================
UPSTASH_REDIS_REST_URL=https://your-production-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-production-token

# Production rate limits (adjust based on your needs)
RATE_LIMIT_MAX=100                   # Higher limit for production
RATE_LIMIT_WINDOW_SECONDS=300        # 5 minutes window

# ============================================
# Application Configuration
# ============================================
# Maximum file size for resume uploads (10MB)
MAX_FILE_SIZE=10485760

# IP hashing salt for privacy-preserving analytics
# Generate: openssl rand -hex 16
IP_HASH_SALT=your-production-ip-hash-salt

# ============================================
# SEO & Site Configuration
# ============================================
# Your production URL (used for sitemap and Open Graph)
NEXT_PUBLIC_APP_URL=https://chat-my-cv.vercel.app

# Site verification (optional but recommended)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=

# ============================================
# Performance & Security
# ============================================
# Production mode
NODE_ENV=production

# Bundle analyzer (set to true to analyze production bundle)
# BUNDLE_ANALYZER_ENABLED=false

# Content Security Policy (optional)
# Configure in next.config.ts for production

# ============================================
# Monitoring (Optional but Recommended)
# ============================================
# Sentry DSN for error tracking
# Get your DSN from: https://sentry.io/settings/projects/{project}/keys/
# Leave empty to disable Sentry
NEXT_PUBLIC_SENTRY_DSN=

# Optional: For source map uploads (improves error stack traces)
# Create auth token at: https://sentry.io/settings/auth-tokens/
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-auth-token

# Analytics (e.g., Google Analytics, Plausible)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# IMPORTANT PRODUCTION CHECKLIST
# ============================================
# Before deploying to production, ensure:
# 
# 1. All required environment variables are set
# 2. Strong, unique passwords and secrets are used
# 3. NEXTAUTH_URL matches your production domain exactly
# 4. Supabase project is in production mode
# 5. Rate limiting is properly configured
# 6. SSL/TLS is enabled (handled by hosting provider)
# 7. Database backups are configured in Supabase
# 8. Error monitoring is set up (e.g., Sentry)
# 9. Analytics tracking is configured (optional)
# 10. Content Security Policy headers are configured
#
# Security reminders:
# - Never commit .env.production.local to version control
# - Rotate secrets regularly
# - Use environment variables from your hosting provider's dashboard
# - Enable audit logging in Supabase
# - Set up alerting for suspicious activity